# Favn360 Core environment configuration
#
# Copy this file to .env.local for local development.
# Never commit .env.local or production credentials.


# Application
# Public origin of this Favn360 installation. No trailing slash.

APP_ORIGIN=http://localhost:3000


# Supabase
# Each Favn360 installation should use its own Supabase project.
# These values are available from the Supabase project configuration.
#
# Never place service-role keys or other privileged secrets in
# NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key


# Storage
# Supabase Storage bucket used for documents.

DOCUMENT_BUCKET_NAME=favn360-documents


# Development
# Enables development/demo functionality where supported.
# Keep disabled in production.

DEMO_MODE=false


# AI analysis
# AI functionality is disabled by default.
#
# OPENAI_API_KEY is server-only and must never be exposed through a
# NEXT_PUBLIC_* variable.
#
# Organizations deploying Favn360 are responsible for assessing the
# applicable privacy, data-protection and regulatory requirements before
# enabling AI processing.

ENABLE_AI_ANALYSIS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://eu.api.openai.com/v1
