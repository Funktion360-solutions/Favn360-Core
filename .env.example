# Public application origin. No trailing slash.
APP_ORIGIN=http://localhost:3000

# Supabase publishable configuration. Never put a secret/service-role key in
# a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only. Prefer leaving this unset unless a reviewed admin flow needs it.
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_BUCKET_NAME=favn360-documents

# Development-only sample data. This is ignored in production.
DEMO_MODE=false

# AI is disabled by default. Do not enable it before the DPIA, Article 9 legal
# basis, DPA, EU data residency and retention controls are approved.
ENABLE_AI_ANALYSIS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://eu.api.openai.com/v1

# Raw IP addresses and user agents are not stored by default.
AUDIT_LOG_NETWORK_METADATA=false
AUDIT_IP_HASH_KEY=
