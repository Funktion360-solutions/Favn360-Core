{
  "name": "favn360-platform-core",
  "version": "0.2.0",
  "private": true,
  "description": "Favn360 webplatform til sikker funktionsdokumentation.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/validate-env.mjs && next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:release": "npm run check:secrets && npm run lint && npm run typecheck && npm audit --audit-level=high && npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "0.475.0",
    "next": "16.3.6",
    "openai": "7.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
